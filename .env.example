# Jira CLI Configuration Example
# Copy this file to .env and fill in your credentials

# Your Jira domain (without https://)
JIRA_CLI__JIRA_DOMAIN=your-domain.atlassian.net

# Your Jira account email
JIRA_CLI__JIRA_EMAIL=your-email@example.com

# Your Jira API token (generate from: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_CLI__JIRA_API_TOKEN=your-api-token-here

# Optional: Logging configuration
# JIRA_CLI__LOG_LEVEL=INFO
# JIRA_CLI__LOG_FILE_DIR=logs
